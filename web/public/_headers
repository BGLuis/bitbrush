# Netlify / Cloudflare Pages headers. main.wasm must be served as
# application/wasm for WebAssembly.instantiateStreaming to accept it, and
# the build emits precompressed .br/.gz siblings (scripts/compress-wasm.mjs).
# Hashed JS/CSS assets are immutable; the wasm and shell are not hashed.

/main.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=86400

/wasm_exec.js
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable
